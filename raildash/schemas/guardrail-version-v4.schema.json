{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datrail:guardrail:guardrail-version:4",
  "title": "DatRail OSS Data Guardrail version v4",
  "$comment": "Version 4 of one immutable guardrail version: v3's rules, egress_containment and data_actions both optional, and three optional members of the uploads rule (REST uploads design section 4, 'The guardrail contract'): body_kind_overrides (a user's 'this is parameters' / 'this is an upload' for one host, method and path template), parameters_budget (the drip check's bounds, raised or lowered for one out_of_spec_calls entry or for the agent) and parameters_only_hosts (hosts the agent sent only parameters bodies to while learning; none of the three widens allowed_hosts). A version is written at v4 exactly when its uploads rule has one of them, so the same rule set never has two encodings. Every v1-v3 rule is otherwise unchanged. Rules this schema cannot express are checked in code (raildash.guardrail.guardrail_problems).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "guardrail_contract_version",
    "guardrail_version_id",
    "version",
    "created_at",
    "agent_identity",
    "derived_from",
    "rules"
  ],
  "properties": {
    "guardrail_contract_version": {
      "const": 4
    },
    "guardrail_version_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent_identity": {
      "$ref": "#/$defs/identity"
    },
    "derived_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_version_id"
      ],
      "properties": {
        "alignment_version_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploads",
        "saved_files",
        "service_ports",
        "out_of_spec_calls"
      ],
      "properties": {
        "uploads": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_hosts",
            "max_request_bytes",
            "denied_tool_calls"
          ],
          "properties": {
            "allowed_hosts": {
              "$ref": "#/$defs/hosts"
            },
            "max_request_bytes": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/host"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "denied_tool_calls": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "body_kind_overrides": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 1024,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "host",
                  "method",
                  "path",
                  "kind"
                ],
                "properties": {
                  "host": {
                    "$ref": "#/$defs/host",
                    "$comment": "An exact host: a wildcard is refused in code."
                  },
                  "method": {
                    "type": "string",
                    "pattern": "^[A-Z]{1,16}$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "^/",
                    "$comment": "The path template RailDash writes (raildash.body_kinds.path_template): the literal path, query dropped, each all-digit, UUID or long opaque segment written as *."
                  },
                  "kind": {
                    "enum": [
                      "parameters",
                      "upload"
                    ]
                  }
                }
              },
              "minItems": 1
            },
            "parameters_budget": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "agent": {
                  "type": "integer",
                  "minimum": 0,
                  "$comment": "Bytes of parameters bodies a day for the agent; RailDash's default is 1 MiB."
                },
                "entries": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "$ref": "#/$defs/host"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "$comment": "Bytes a day per out_of_spec_calls.allowed_hosts entry (or per host matching none); RailDash's default is 256 KiB."
                }
              }
            },
            "parameters_only_hosts": {
              "$ref": "#/$defs/hosts",
              "minItems": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "body_kind_overrides"
              ]
            },
            {
              "required": [
                "parameters_budget"
              ]
            },
            {
              "required": [
                "parameters_only_hosts"
              ]
            }
          ]
        },
        "saved_files": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed"
          ],
          "properties": {
            "allowed": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/saved_file"
              }
            }
          }
        },
        "service_ports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed"
          ],
          "properties": {
            "allowed": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/port"
              }
            }
          }
        },
        "out_of_spec_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed_hosts",
            "allowed_mcp_servers",
            "seeded_from_declared"
          ],
          "properties": {
            "allowed_hosts": {
              "$ref": "#/$defs/hosts"
            },
            "allowed_mcp_servers": {
              "$ref": "#/$defs/mcp_servers"
            },
            "seeded_from_declared": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hosts",
                "mcp_servers"
              ],
              "properties": {
                "hosts": {
                  "$ref": "#/$defs/hosts"
                },
                "mcp_servers": {
                  "$ref": "#/$defs/mcp_servers"
                }
              }
            }
          }
        },
        "data_actions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowed",
            "overrides",
            "unclassified"
          ],
          "properties": {
            "allowed": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "tool",
                  "actions"
                ],
                "properties": {
                  "tool": {
                    "$ref": "#/$defs/tool_pattern"
                  },
                  "actions": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "read",
                        "upload",
                        "update",
                        "delete",
                        "execute",
                        "unclassified",
                        "unreadable",
                        "not_offered"
                      ]
                    }
                  }
                }
              }
            },
            "overrides": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/tool_pattern"
              },
              "additionalProperties": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "read",
                    "upload",
                    "update",
                    "delete",
                    "execute"
                  ]
                }
              }
            },
            "unclassified": {
              "enum": [
                "flag",
                "allow"
              ]
            }
          }
        },
        "egress_containment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "require"
          ],
          "properties": {
            "require": {
              "enum": [
                "contained",
                "allow_list_enforced"
              ],
              "$comment": "contained: any contained level of the newest ASP's egress_containment (allow_list_enforced, no_network, internal_network). allow_list_enforced: only that level."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "host": {
      "$comment": "An exact host name, or `*.` and a name for any subdomain of it (never the name itself). No other `*`, no port, no IP range. The normalized form (lower case, no trailing dot) is checked in code.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(\\*\\.)?[^*\\s/\\[\\]]+$"
    },
    "hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/host"
      }
    },
    "mcp_servers": {
      "$comment": "MCP server names after the normalization agents apply when they build tool names: every character outside [A-Za-z0-9_-] is `_`.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "kind": {
      "$comment": "The values /api/profile's file_types uses: a lower-cased extension with its dot, or (none). (other), an over-long extension, would allow any long extension and is refused.",
      "not": {
        "const": "(other)"
      },
      "anyOf": [
        {
          "const": "(none)"
        },
        {
          "type": "string",
          "pattern": "^\\.[^./\\\\A-Z\\s]{1,15}$"
        }
      ]
    },
    "saved_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kind"
          }
        },
        "literal": {
          "type": "boolean"
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "port"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ]
        },
        "port": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "const": "ephemeral"
            }
          ]
        },
        "addr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "deployment_environment"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "deployment",
                "namespace"
              ],
              "properties": {
                "deployment": {
                  "type": "string",
                  "minLength": 1
                },
                "namespace": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "deployment_compose"
            },
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "host_id",
                "project",
                "service"
              ],
              "properties": {
                "host_id": {
                  "type": "string",
                  "minLength": 1
                },
                "project": {
                  "type": "string",
                  "minLength": 1
                },
                "service": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "local_agent_key"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "local_agent_keys"
            },
            "value": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              }
            }
          }
        }
      ]
    },
    "tool_pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
