{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datrail:asp:drift-result:1",
  "title": "DatRail ASP drift result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["drift_contract_version", "comparable", "has_drift", "reason", "change_count", "changes", "truncated"],
  "properties": {
    "drift_contract_version": {"const": 1},
    "comparable": {"type": "boolean"},
    "has_drift": {"type": ["boolean", "null"]},
    "reason": {"type": ["string", "null"], "enum": [null, "IDENTITY_MISMATCH", "CONTRACT_MISMATCH", "INVALID_BUNDLE", "ALIGNMENT_INTEGRITY_FAILED", "NO_ACTIVE_ALIGNMENT"]},
    "change_count": {"type": "integer", "minimum": 0},
    "changes": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/change"}},
    "truncated": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"comparable": {"const": true}}},
      "then": {"properties": {"has_drift": {"type": "boolean"}, "reason": {"const": null}}},
      "else": {"properties": {"has_drift": {"const": null}, "reason": {"enum": ["IDENTITY_MISMATCH", "CONTRACT_MISMATCH", "INVALID_BUNDLE", "ALIGNMENT_INTEGRITY_FAILED", "NO_ACTIVE_ALIGNMENT"]}}}
    }
  ],
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "fields"],
      "properties": {
        "type": {"enum": ["ATTRIBUTE_ADDED", "ATTRIBUTE_REMOVED", "ATTRIBUTE_CHANGED", "SOURCE_ADDED", "SOURCE_REMOVED", "SOURCE_CHANGED", "ATTESTATION_ADDED", "ATTESTATION_REMOVED", "ATTESTATION_CHANGED"]},
        "name": {"type": "string", "minLength": 1},
        "fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
