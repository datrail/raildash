{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:datrail:asp:alignment-version:1",
  "title": "DatRail ASP alignment version v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["alignment_contract_version", "alignment_version_id", "version", "locked_at", "agent_identity", "contract", "asp"],
  "properties": {
    "alignment_contract_version": {"const": 1},
    "alignment_version_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "locked_at": {"type": "string", "format": "date-time"},
    "agent_identity": {"$ref": "#/$defs/identity"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_version", "rule_pack_version"],
      "properties": {
        "bundle_version": {"const": 1},
        "rule_pack_version": {"type": "integer", "minimum": 1}
      }
    },
    "asp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asp_id", "digest"],
      "properties": {
        "asp_id": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "deployment_environment"},
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["deployment", "namespace"],
              "properties": {"deployment": {"type": "string", "minLength": 1}, "namespace": {"type": "string", "minLength": 1}}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "deployment_compose"},
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": ["host_id", "project", "service"],
              "properties": {"host_id": {"type": "string", "minLength": 1}, "project": {"type": "string", "minLength": 1}, "service": {"type": "string", "minLength": 1}}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "local_agent_key"}, "value": {"type": "string", "minLength": 1, "maxLength": 128}}
        }
      ]
    }
  }
}
